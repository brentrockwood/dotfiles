#!/usr/bin/env bash

if [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
Usage: notify <message>
       notify --help

Send a Telegram notification prefixed with the current directory name.
All message arguments are joined with spaces.

Credentials: $XDG_CONFIG_HOME/telegram-notify/env
             (defaults to ~/.config/telegram-notify/env)
Variables: TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_CHATID
EOF
    exit 0
fi

CREDENTIALS="${XDG_CONFIG_HOME:-$HOME/.config}/telegram-notify/env"
if [ -r "$CREDENTIALS" ]; then
    # shellcheck disable=SC1090
    source "$CREDENTIALS"
fi

if [ -z "$*" ]; then
    echo "Usage: notify <message>" >&2
    exit 1
fi

PROJECT="[$(basename "$PWD")]"
MESSAGE="$PROJECT $*"

RESPONSE=$(curl -s --max-time 10 -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage" \
     -d chat_id="$TELEGRAM_BOT_CHATID" \
     -d text="$MESSAGE")

# No response indicates a network/timeout failure
if [ -z "$RESPONSE" ]; then
    echo "Error: No response from Telegram API." >&2
    exit 1
fi

# Parse the "ok" field — jq -e returns non-zero if false or null
if echo "$RESPONSE" | jq -e '.ok' > /dev/null 2>&1; then
    exit 0
else
    ERROR_MSG=$(echo "$RESPONSE" | jq -r '.description' 2>/dev/null || echo "Invalid JSON: $RESPONSE")
    echo "Error: $ERROR_MSG" >&2
    exit 1
fi
