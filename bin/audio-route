#!/usr/bin/env bash
# Route this Lenovo SoundWire card through its real speaker PCM device.
# The stereo-fallback profile selects Jack Out (device 0), while speakers are device 2.
set -euo pipefail

card="alsa_card.pci-0000_00_1f.3-platform-sof_sdw"
sink="alsa_output.pci-0000_00_1f.3-platform-sof_sdw.pro-output-2"

command -v pactl >/dev/null 2>&1 || exit 0

for _ in {1..10}; do
  if pactl list short cards 2>/dev/null | awk -v card="$card" '$2 == card { found = 1 } END { exit !found }'; then
    pactl set-card-profile "$card" pro-audio
    pactl set-default-sink "$sink"
    exit 0
  fi
  sleep 1
done

exit 0
