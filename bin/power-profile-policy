#!/usr/bin/env bash
set -euo pipefail

exec 9>"${XDG_RUNTIME_DIR:?}/power-profile-policy.lock"
flock -n 9 || exit 0

last_profile=
apply_profile() {
  local info state percentage profile
  info=$(upower -i /org/freedesktop/UPower/devices/DisplayDevice)
  state=$(awk -F: '/^[[:space:]]*state:/ {gsub(/^[[:space:]]+/, "", $2); print $2; exit}' <<<"$info")
  percentage=$(awk -F: '/^[[:space:]]*percentage:/ {gsub(/[^0-9]/, "", $2); print $2; exit}' <<<"$info")

  case $state in
    charging|fully-charged) profile=performance ;;
    *) (( percentage <= 20 )) && profile=power-saver || profile=balanced ;;
  esac

  [[ $profile == "$last_profile" ]] && return
  powerprofilesctl set "$profile"
  last_profile=$profile
}

apply_profile
[[ ${1:-} == --once ]] && exit 0
upower --monitor-detail | while IFS= read -r _; do apply_profile; done
