{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 8,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["sway/window"],
  "modules-right": ["pulseaudio", "group/power", "clock", "tray"],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true
  },
  "sway/window": {
    "max-length": 60,
    "separate-outputs": false
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Volume: {volume}%",
    "on-click": "pavucontrol"
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": ["battery", "power-profiles-daemon"]
  },
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "",
    "format-plugged": "",
    "format-alt": "{time} remaining",
    "tooltip-format": "Battery: {capacity}%\n{time}",
    "format-icons": ["", "", "", "", ""]
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}"
  },
  "clock": {
    "format": "{:%a %b %d  %H:%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": {
    "icon-size": 20,
    "spacing": 8
  }
}
